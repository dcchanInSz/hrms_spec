{
  "name": "hr-system-backend",
  "version": "1.0.0",
  "description": "小企业人力资源管理系统 - 后端 API",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "migrate": "node scripts/migrate.js",
    "migrate:down": "node scripts/migrate-down.js",
    "seed": "node scripts/seed.js",
    "db:reset": "npm run migrate:down && npm run migrate && npm run seed"
  },
  "keywords": ["hr", "management", "express", "postgresql"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/app.js"],
    "coverageDirectory": "coverage",
    "verbose": true
  }
}
